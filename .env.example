# Copy to .env and fill in. Never commit .env.

# Local dev database (docker compose)
DATABASE_URL=postgresql://kwamz:kwamz@localhost:54322/kwamz_radio

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Apple Developer
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=kwamz.radio
APPLE_MUSICKIT_KEY_ID=
# Path to the MusicKit .p8 key (keep it outside the repo)
APPLE_MUSICKIT_PRIVATE_KEY_PATH=
# Apple Music storefront for catalog search (two-letter country code)
APPLE_MUSIC_STOREFRONT=ca

# Google
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
YOUTUBE_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kwam-radio-data
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
