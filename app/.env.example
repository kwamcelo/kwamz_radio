# Copy to .env.local (git-ignored) and fill in. Everything here is inlined into the app
# bundle, so never put a secret in an EXPO_PUBLIC_ variable.

# The FastAPI server. On a real iPhone use your Mac's LAN address, not localhost
# (run the API with --host 0.0.0.0).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Same values as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY in the root .env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Same values as GOOGLE_WEB_CLIENT_ID / GOOGLE_IOS_CLIENT_ID in the root .env
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Your Apple Developer team ID (same as APPLE_TEAM_ID in the root .env); signs local iOS builds
APPLE_TEAM_ID=
